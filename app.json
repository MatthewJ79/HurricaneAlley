{
  "expo": {
    "name": "Hurricane Alley",
    "slug": "hurricane-alley",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hurricanealley.app"
    },
    "android": {
      "package": "com.hurricanealley.app",
      "adaptiveIcon": {
        "backgroundColor": "#071116"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "@maplibre/maplibre-react-native"
    ]
  }
}
